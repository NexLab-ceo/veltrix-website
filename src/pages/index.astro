---
import Base from '../layouts/Base.astro';
import '../styles.css';
---
<Base title="VELTRIX — Infrastructure, simplified" description="A clear, unified platform for managing your infrastructure.">
  <section class="container hero">
    <div>
      <div class="eyebrow">Infrastructure, simplified</div>
      <h1>More control.<br/><span>Less complexity.</span></h1>
      <p class="lead">A connected platform for managing devices, services and websites — with the clarity and control your infrastructure deserves.</p>
      <div class="hero-actions"><a class="button button-dark" href="/product/">Explore the platform <span>↗</span></a><a class="button button-light" href="/download/">Get started</a></div>
      <div class="hero-note">Built by NexLab · Designed for independent builders</div>
    </div>
    <div class="visual" aria-label="Abstract VELTRIX platform illustration">
      <span class="visual-label label-a">One platform</span><span class="visual-label label-b">Your infrastructure</span>
      <span class="orbit-dot dot-a"></span><span class="orbit-dot dot-b"></span><span class="orbit-dot dot-c"></span>
      <div class="orbit-core">V</div>
    </div>
  </section>
  <section class="section" style="background:#fff">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">The platform</div><h2 style="margin-top:18px">Everything connected.<br/>Nothing in the way.</h2></div><p>Bring the essential parts of your infrastructure into one clear workspace. Start small, expand when you need to.</p></div>
      <div class="feature-grid">
        <article class="feature-card"><div class="feature-icon">⌘</div><h3>One workspace</h3><p>Keep devices, websites and services organised in a single place.</p></article>
        <article class="feature-card"><div class="feature-icon">↗</div><h3>Deploy with clarity</h3><p>Understand what is running, where it lives and what changed.</p></article>
        <article class="feature-card"><div class="feature-icon">◌</div><h3>Built to extend</h3><p>A modular approach that can grow alongside your infrastructure.</p></article>
      </div>
    </div>
  </section>
  <section class="section"><div class="container split"><div><div class="eyebrow">A calmer way to operate</div><h2 style="margin:20px 0">Your infrastructure should feel understandable.</h2><p>VELTRIX brings operational tools into a focused experience. Spend less time jumping between utilities and more time building what matters.</p><a class="button button-dark" href="/product/">Discover VELTRIX <span>↗</span></a></div><div class="split-panel"><span class="tag">VELTRIX / SYSTEM</span><div class="big">01—03</div><div><strong>Devices · Sites · Services</strong><p>One consistent place to see the bigger picture.</p></div></div></div></section>
  <section class="band"><div class="container band-inner"><div><div class="eyebrow" style="color:#a9baff">Get started</div><h2 style="margin-top:20px">Build your setup.<br/>Keep control.</h2><p>Explore the platform and find the right starting point for your environment.</p></div><a class="button button-white" href="/download/">Explore downloads <span>↗</span></a></div></section>
</Base>
