---
import SiteLayout from '../layouts/SiteLayout.astro';
const templates = [
  ['01','Static Website','HTML · CSS · JavaScript','A lightweight starting point for frontend sites and documentation.'],
  ['02','Node.js','JavaScript · TypeScript','Build APIs, bots and small backend services.'],
  ['03','PHP','PHP','Run familiar PHP applications and lightweight web projects.'],
  ['04','Go','Go','Create compact services and command-line tools.']
];
---
<SiteLayout title="Templates" description="Explore planned Yevqo project templates for Android and Termux.">
  <div class="page-kicker">03 / QUICK STARTS</div>
  <h1 class="page-title">A better start for<br/><span>every project.</span></h1>
  <p class="page-lead">A starter catalogue designed for common workloads that can run in an Android + Termux environment.</p>
  <div class="page-grid">
    {templates.map(([n,name,stack,desc]) => <article class="page-card"><span class="card-index">{n} / TEMPLATE</span><h2>{name}</h2><p>{desc}</p><div class="code-line">{stack}</div></article>)}
  </div>
  <div class="page-note"><strong>Runtime note:</strong> Template availability does not guarantee every project will run well on every Android device. Docker-based builders such as Nixpacks or Railpack require a separate Linux execution environment and are not assumed to run natively in Termux.</div>
</SiteLayout>
