---
import Base from '../../layouts/Base.astro'; import '../../styles.css';
---
<Base title="Downloads — VELTRIX" description="Download VELTRIX Agent and explore releases.">
  <section class="container page-hero"><div class="eyebrow">Downloads</div><h1>Your setup starts here.</h1><p class="lead">Find VELTRIX components and release information. Only verified public release assets should be linked here.</p></section>
  <section class="container" style="padding-bottom:110px">
    <div class="download-row"><div><span class="tag">Public component</span><h3 style="margin-top:12px">VELTRIX Agent</h3><p>Connect a supported device to a VELTRIX control plane.</p></div><a class="button button-dark" href="https://github.com/NexLab-ceo/veltrix-dock/releases" target="_blank" rel="noreferrer">View releases ↗</a></div>
    <div class="download-row"><div><span class="tag">Platform</span><h3 style="margin-top:12px">VELTRIX Dock</h3><p>Explore the public distribution repository and setup information.</p></div><a class="button button-light" href="https://github.com/NexLab-ceo/veltrix-dock" target="_blank" rel="noreferrer">GitHub ↗</a></div>
    <p style="font-size:12px;color:#9299a4;line-height:1.7;margin-top:28px">Release links are directed to the public Agent distribution. Internal packages and private control-plane builds are not exposed on this page.</p>
  </section>
</Base>
