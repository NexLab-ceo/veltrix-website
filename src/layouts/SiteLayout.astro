---
import '../styles/global.css';
const { title = 'Yevqo', description = 'Turn your Android device into a personal server with Termux and Yevqo.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080a09" />
    <meta name="description" content={description} />
    <title>{title} — Yevqo</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Yevqo home"><span class="brand-mark"><span></span><span></span><span></span></span><span>yevqo</span></a>
      <nav aria-label="Main navigation">
        <a href="/features">Features</a><a href="/how-it-works">How it works</a><a href="/templates">Templates</a><a href="/docs">Documentation</a><a href="/pricing">Pricing</a>
      </nav>
      <div class="nav-actions"><a class="github-link" href="https://github.com/NexLab-ceo" target="_blank" rel="noreferrer">GitHub</a><a class="button button-small" href="/how-it-works">Get started ↗</a></div>
    </header>
    <main class="subpage section-wrap">
      <slot />
    </main>
    <footer class="footer section-wrap">
      <div class="footer-top">
        <div class="footer-brand"><a class="brand" href="/"><span class="brand-mark"><span></span><span></span><span></span></span><span>yevqo</span></a><p>Your Android.<br/>Your Server. Your Control.</p></div>
        <div class="footer-col"><b>PRODUCT</b><a href="/features">Features</a><a href="/how-it-works">How it works</a><a href="/templates">Templates</a><a href="/pricing">Pricing</a></div>
        <div class="footer-col"><b>RESOURCES</b><a href="/docs">Documentation</a><a href="/faq">FAQ</a><a href="https://github.com/NexLab-ceo" target="_blank" rel="noreferrer">GitHub ↗</a></div>
        <div class="footer-col"><b>PROJECT</b><a href="/">Home</a><a href="/#product">Product preview</a></div>
      </div>
      <div class="footer-bottom"><span>© 2026 Yevqo. All rights reserved.</span><span>BUILT FOR THE ANDROID-POWERED FUTURE</span><a href="#">BACK TO TOP ↑</a></div>
    </footer>
  </body>
</html>
<style>
  .subpage{min-height:65vh;padding-top:90px;padding-bottom:95px}
  .page-kicker{font:10px var(--mono);letter-spacing:1.4px;color:#a5ec79;margin-bottom:22px}
  .page-title{font:800 clamp(42px,6vw,68px)/1.08 var(--display);letter-spacing:-3px;margin:0;max-width:850px}
  .page-title span{color:var(--green)}
  .page-lead{max-width:650px;color:#9aa59a;font-size:15px;line-height:1.8;margin:22px 0 0}
  .page-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:54px}
  .page-card{border:1px solid #2c392d;background:linear-gradient(145deg,#111712,#0b0f0c);border-radius:7px;padding:23px;min-height:185px}
  .page-card .card-index{font:9px var(--mono);color:var(--green);letter-spacing:1px}
  .page-card h2{font:650 17px var(--display);margin:18px 0 9px}
  .page-card p{font-size:12px;line-height:1.75;color:#899489;margin:0}
  .page-note{margin-top:35px;padding:18px 20px;border:1px solid #354235;border-radius:6px;color:#a0aca0;font-size:12px;line-height:1.8;background:#101611}
  .page-note strong{color:var(--green)}
  .page-link{display:inline-flex;align-items:center;gap:8px;color:var(--green);font-size:12px;margin-top:24px}
  .faq-stack{max-width:850px;margin-top:45px;border-top:1px solid #303b31}
  .faq-stack details{padding:20px 3px;border-bottom:1px solid #303b31}
  .faq-stack summary{cursor:pointer;color:#e1e8df;font-size:14px}
  .faq-stack p{color:#929d91;font-size:12px;line-height:1.8;max-width:720px;margin:14px 0 0}
  .steps-list{display:grid;gap:15px;margin-top:48px;max-width:850px}
  .step-card{display:grid;grid-template-columns:70px 1fr;gap:20px;padding:24px;border:1px solid #2c392d;border-radius:7px;background:#101611}
  .step-card .number{font:22px var(--display);color:var(--green)}
  .step-card h2{font:650 17px var(--display);margin:0 0 8px}
  .step-card p{font-size:12px;line-height:1.75;color:#929d91;margin:0}
  .code-line{margin-top:13px;padding:11px 13px;background:#080d09;border:1px solid #29352a;border-radius:4px;color:#b8c7b4;font:10px var(--mono);overflow-wrap:anywhere}
  @media(max-width:760px){.subpage{padding-top:65px;padding-bottom:65px}.page-grid{grid-template-columns:1fr 1fr;gap:9px;margin-top:35px}.page-card{padding:17px;min-height:170px}.page-title{letter-spacing:-2px}.page-lead{font-size:13px}.step-card{grid-template-columns:42px 1fr;gap:12px;padding:17px}}
  @media(max-width:480px){.page-grid{grid-template-columns:1fr}.page-card{min-height:0}.topbar{height:auto;min-height:65px;padding:12px 19px;flex-wrap:wrap;gap:8px}.topbar nav{display:flex;order:3;flex-basis:100%;margin:0;gap:19px;overflow-x:auto;padding:7px 0 3px;scrollbar-width:none}.topbar nav::-webkit-scrollbar{display:none}.topbar nav a{white-space:nowrap;font-size:11px}.nav-actions{margin-left:auto}.github-link{display:none}}
</style>
