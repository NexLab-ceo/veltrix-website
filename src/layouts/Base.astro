---
const { title = 'VELTRIX Dock — хостинг на Android', description = 'Превратите Android-телефон в собственный сервер с веб-панелью VELTRIX Dock.' } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090d0b" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="VELTRIX Dock — главная"><span class="brand-mark">V</span><span>VELTRIX <b>DOCK</b></span></a>
      <nav class="nav" aria-label="Основная навигация">
        <a href="#how-it-works">Как работает</a>
        <a href="#features">Возможности</a>
        <a href="#proof">Доказательство</a>
      </nav>
      <div class="header-actions">
        <a class="github-link" href="https://github.com/NexLab-ceo/veltrix-dock" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a class="button button-primary button-small" href="https://github.com/NexLab-ceo/veltrix-dock/releases" target="_blank" rel="noreferrer">Скачать <span>↗</span></a>
        <button class="menu-toggle" aria-label="Открыть меню" aria-expanded="false"><span></span><span></span></button>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="footer-main">
        <div>
          <a class="brand" href="/"><span class="brand-mark">V</span><span>VELTRIX <b>DOCK</b></span></a>
          <p>Твой сервер. Твой телефон. Твои правила.</p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/NexLab-ceo/veltrix-dock" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="https://docs.veltrix.com" target="_blank" rel="noreferrer">Документация ↗</a>
          <a href="https://github.com/NexLab-ceo/veltrix-dock/blob/main/LICENSE" target="_blank" rel="noreferrer">Лицензия · Freeware ↗</a>
        </div>
      </div>
      <div class="footer-bottom"><span>© 2026 NexLab. VELTRIX Dock is freeware.</span><span>Сделано для самостоятельного хостинга.</span></div>
    </footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('nav-open', !open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('nav-open');
        toggle?.setAttribute('aria-expanded', 'false');
      }));
    </script>
  </body>
</html>
